#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Start the installer.
#
# Two things Calamares needs and a plain Exec line does not give it:
#
#   * root. It partitions and mounts; unprivileged it exits instead of
#     installing. The live image's tahoe user has NOPASSWD sudo
#     (etc/sudoers.d/10-tahoe-live, which is shipped only into the live
#     image), so -n is enough and cannot hang on a prompt.
#
#   * the session's display environment. sudo resets it by default, and a
#     Calamares that cannot see WAYLAND_DISPLAY opens no window at all — it
#     runs, does nothing visible, and looks like a broken launcher. Only the
#     variables a Qt application needs to find the compositor are preserved.
#
# A wrapper rather than a longer Exec line because the same command has to be
# reachable from the app menu and from the session's keybind, and one place to
# fix is better than two.
set -eu

PRESERVE="WAYLAND_DISPLAY,DISPLAY,XDG_RUNTIME_DIR,QT_QPA_PLATFORM,XDG_SESSION_TYPE"

# Qt picks the X11 backend whenever DISPLAY is set, and this image has no X
# server at all, so the process aborts before drawing a window:
#   qt.qpa.xcb: could not connect to display :0
#   This application failed to start because no Qt platform plugin could be
#   initialized.
# The session is Wayland-only, so name that backend unless the caller did.
if [ -z "${QT_QPA_PLATFORM:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    export QT_QPA_PLATFORM=wayland
fi
# No --branding here: Calamares 3.4.2 has no such option (its command line is
# -d, -D, -T, -c/--config, -X — see src/calamares/main.cpp). Passing it makes
# calamares print "Unknown option 'branding'" and exit without a window. The
# branding is chosen in settings.conf (`branding: tahoe`), which is the only
# place it is read.
exec sudo -n --preserve-env="$PRESERVE" calamares "$@"
