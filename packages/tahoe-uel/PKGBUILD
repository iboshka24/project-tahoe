# SPDX-License-Identifier: 0BSD
# Maintainer: Project Tahoe
# STATUS: prototype, NOT YET BUILT (needs clean chroot + network for crates).
pkgname=tahoe-uel
pkgver=0.1.0
pkgrel=1
pkgdesc='Universal Execution Layer: probe binaries, choose a run strategy'
arch=('x86_64')
url='https://github.com/iboshka24/project-tahoe'
license=('MIT' 'Apache-2.0')
depends=('gcc-libs')
makedepends=('cargo' 'git')
source=("git+https://github.com/iboshka24/project-tahoe.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
	cd "project-tahoe"
	cargo build --release --locked -p tahoe-uel
}

package() {
	cd "project-tahoe"
	install -Dm755 "target/release/tahoe-uel" "$pkgdir/usr/bin/tahoe-uel"
	# The binfmt_misc interpreter. Without this file the registration in
	# /usr/lib/binfmt.d/tahoe-wine.conf cannot be added at boot.
	install -Dm755 "target/release/tahoe-dispatch" "$pkgdir/usr/lib/tahoe/tahoe-dispatch"
	install -Dm644 LICENSING.md "$pkgdir/usr/share/doc/$pkgname/LICENSING.md"
}
